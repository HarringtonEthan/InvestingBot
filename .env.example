# Copy this file to .env and fill in your Alpaca PAPER trading keys
# (from https://app.alpaca.markets/paper/dashboard/overview -> API Keys).
# Never commit your real .env file.

ALPACA_API_KEY=your_paper_api_key_id
ALPACA_SECRET_KEY=your_paper_secret_key

# Leave this as the paper endpoint. Only change it once you've decided,
# deliberately, to go live - and even then live_trade.py requires the
# --i-understand-this-is-live flag on top of this.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
